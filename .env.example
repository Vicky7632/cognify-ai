# Copy to .env for local development. This file intentionally contains placeholders only.

# Application
COGNIFY_ENV=development
COGNIFY_LOG_LEVEL=INFO
COGNIFY_MAX_UPLOAD_BYTES=52428800

# Vector database (planned; configure only when integration is implemented)
PINECONE_API_KEY=replace-me
PINECONE_INDEX=replace-me
PINECONE_REGION=replace-me

# Embeddings (provider/model to be selected through evaluation)
EMBEDDING_PROVIDER=replace-me
EMBEDDING_MODEL=replace-me

# LLM provider (implementation/provider to be selected)
LLM_PROVIDER=replace-me
LLM_API_KEY=replace-me
LLM_MODEL=replace-me

# Local transcription (model/runtime to be evaluated)
WHISPER_MODEL=replace-me
FFMPEG_PATH=ffmpeg
