# Planned configuration placeholders only; replace locally as needed.
# Never commit .env or place real credentials in this template.

# PostgreSQL relational data
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cognify_ai

# Pinecone vector search
PINECONE_API_KEY=replace-me
PINECONE_INDEX=replace-me
PINECONE_UPSERT_BATCH_SIZE=100

# Local document uploads (25 MiB default)
COGNIFY_UPLOAD_ROOT=storage/uploads
COGNIFY_MAX_UPLOAD_SIZE_BYTES=26214400

# Google Gemini embeddings
GEMINI_API_KEY=replace-me
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072
TRANSCRIPTION_MODEL=replace-me
LLM_PROVIDER=replace-me
LLM_MODEL=replace-me
